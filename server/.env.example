# 数据库（腾讯云 CDB 或自建 MySQL 8）
DATABASE_URL="mysql://root:1234@127.0.0.1:3306/yangming?charset=utf8mb4"

# 服务端口
PORT=3001

# 上传文件公网/本地访问地址，本地测试用 127.0.0.1，部署服务器后改成 http://服务器IP:3001 或正式域名
PUBLIC_BASE_URL="http://127.0.0.1:3001"

# JWT
JWT_SECRET="请改成长随机字符串超过32位_abcDEF1234567890!@#$"
JWT_EXPIRES_IN="7d"

# Redis（可选，不配则禁用缓存）
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ============ 微信小程序（两个独立小程序）============
# 零售（B2C）：完整微信支付链路。
# 批发：B2B 提交采购单 + 客服线下结算，不接微信支付，只用 AppID/Secret 调
#       jscode2session 拿 openid 做身份识别。
# 后端按 channel 选 AppID/Secret：retail 走支付，wholesale 仅登录。
#
# 零售（B2C）小程序：兼容老配置 WX_APPID/WX_SECRET（等同 *_RETAIL）
WX_APPID="wx4614b3d303424458"
WX_SECRET=""
WX_APPID_RETAIL=""
WX_SECRET_RETAIL=""
# 批发小程序（仅用于登录，不需要支付商户号；不配则批发端登录走 dev fallback）
WX_APPID_WHOLESALE=""
WX_SECRET_WHOLESALE=""

# 本地开发时，微信 code 换 openid 失败则自动使用测试用户；上线务必改为 false
WX_LOGIN_DEV_FALLBACK="true"

# ============ 微信支付 V3（小程序 JSAPI 支付）============
# 商户号
WX_PAY_MCHID=""
# 商户 API 证书序列号
WX_PAY_SERIAL_NO=""
# apiclient_key.pem 绝对路径（建议放在 server/secrets/apiclient_key.pem，并加入 .gitignore）
WX_PAY_PRIVATE_KEY_PATH=""
# APIv3 密钥（32 位）
WX_PAY_API_V3_KEY=""
# 支付结果回调 URL（公网可访问，HTTPS）
# 例：https://api.your-domain.com/api/client/pay/notify
WX_PAY_NOTIFY_URL=""
# 上述任一项为空时，下单接口会返回 503 “微信支付未配置”，前端会提示用户。

# 腾讯云 COS（图片存储）
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION="ap-shanghai"
COS_DOMAIN=""

# ============ 快递100（物流轨迹查询/订阅）============
# 客户编号 customer，控制台 https://api.kuaidi100.com/manager/v2/myinfo/enterprise
KUAIDI100_CUSTOMER=""
# 授权 key（不要泄露），服务端用于本地 MD5 签名
KUAIDI100_KEY=""
# 任一项为空 -> Kuaidi100Service 调用时直接抛 503，前端会得到“快递100 未配置”
