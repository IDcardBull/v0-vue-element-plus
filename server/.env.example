# 数据库（腾讯云 CDB 或自建 MySQL 8）
DATABASE_URL="mysql://root:1234@127.0.0.1:3306/yangming?charset=utf8mb4"

# 服务端口
PORT=3001

# JWT
JWT_SECRET="请改成长随机字符串超过32位_abcDEF1234567890!@#$"
JWT_EXPIRES_IN="7d"

# Redis（可选，不配则禁用缓存）
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# 微信小程序
WX_APPID="your_miniprogram_appid"
WX_SECRET="your_miniprogram_secret"

# 腾讯云 COS（图片存储）
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION="ap-shanghai"
COS_DOMAIN=""
