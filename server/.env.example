# 数据库（腾讯云 CDB 或自建 MySQL 8）
DATABASE_URL="mysql://root:your_password@127.0.0.1:3306/yangming?charset=utf8mb4"

# 服务端口
PORT=3001

# JWT
JWT_SECRET="请改成长随机字符串超过32位_abcDEF1234567890!@#$"
JWT_EXPIRES_IN="7d"

# Redis（可选，不配则禁用缓存）
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# 微信小程序
WX_APPID="your_miniprogram_appid"
WX_SECRET="your_miniprogram_secret"

# 微信支付 V3（小程序 JSAPI 支付）
# 任一项为空会导致 /client/pay/* 接口返回 503，不影响其它接口
WX_PAY_MCHID="your_merchant_id"                   # 商户号
WX_PAY_SERIAL_NO="your_cert_serial_no"            # 商户 API 证书序列号
WX_PAY_PRIVATE_KEY_PATH="./certs/apiclient_key.pem"  # 商户私钥 pem 路径（相对或绝对）
WX_PAY_API_V3_KEY="32_chars_api_v3_key_here_______"  # APIv3 密钥，32 位
WX_PAY_NOTIFY_URL="https://your-domain.com/api/client/pay/notify"

# 腾讯云 COS（图片存储）
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION="ap-shanghai"
COS_DOMAIN=""
