# 数据库（腾讯云 CDB 或自建 MySQL 8）
DATABASE_URL="mysql://root:1234@127.0.0.1:3306/yangming?charset=utf8mb4"

# 服务端口
PORT=3001

# 上传文件公网/本地访问地址，本地测试用 127.0.0.1，部署服务器后改成 http://服务器IP:3001 或正式域名
PUBLIC_BASE_URL="http://127.0.0.1:3001"

# JWT
JWT_SECRET="请改成长随机字符串超过32位_abcDEF1234567890!@#$"
JWT_EXPIRES_IN="7d"

# Redis（可选，不配则禁用缓存）
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# 微信小程序
WX_APPID="wx4614b3d303424458"
WX_SECRET="67d6535f10aea4d231592b2ee28cf861"
# 本地开发时，微信 code 换 openid 失败则自动使用测试用户；上线务必改为 false
WX_LOGIN_DEV_FALLBACK="true"

# 腾讯云 COS（图片存储）
